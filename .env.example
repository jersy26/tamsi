# Velo: velo-build.dev dashboard, Testnet project owned by the treasury wallet
VELO_API_KEY=
VELO_WEBHOOK_SECRET=

# Stellar Testnet keys: written by `pnpm setup:testnet`
TREASURY_SECRET=
OFW_SECRET=
AGENT_SECRET=
MERCHANT_SECRETS=

# Card UID string: written by `pnpm setup:testnet`, or use a real tag
DEMO_CARD_UID=

# DB file on the Railway volume, e.g. /data/tamsi.db
SQLITE_PATH=
# Live URL, used for Velo success/cancel URLs
PUBLIC_URL=
# Mock display rate
DEMO_PHP_PER_XLM=
# PIN for the kill switch on /ofw; the switch stays off without it
KILL_SWITCH_PIN=
